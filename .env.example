# Nazar AI — Environment Variables
# Copy to .env.local and fill in values

# Bedrock Chatbot Lambda Function URL
# After deploying the Amplify backend, find this in CloudFormation outputs:
# Stack → Outputs → ChatbotFunctionUrl
# Or run: npx ampx sandbox → look for "ChatbotFunctionUrl" in output
VITE_BEDROCK_ENDPOINT=https://YOUR_FUNCTION_URL.lambda-url.us-east-1.on.aws/
