# Nazar AI — Environment Variables
# Copy to .env.local and fill in values.

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# These are baked into the client bundle. Defaults assume same-origin via the
# Traefik Ingress; override only if you're running the dev server locally and
# need to point at the cluster directly.
# VITE_AUTH_URL=https://nazarai.gheware-ai.com/auth
# VITE_GRAPHQL_URL=https://nazarai.gheware-ai.com/api/graphql
# VITE_CHAT_URL=https://nazarai.gheware-ai.com/api/chat

# ─── E2E tests (vitest) ─────────────────────────────────────────────────────
# Hasura admin secret — needed for OTP injection and cleanup
HASURA_ADMIN_SECRET=

# OTP pepper — must match the value in the nazar-auth-env k8s Secret on the
# cluster. Tests need it to bcrypt-hash injected OTPs the same way the auth
# service does, otherwise /auth/verify won't accept the test OTP.
OTP_PEPPER=

# Optional: override the public URL the tests hit
# TEST_PUBLIC_URL=https://nazarai.gheware-ai.com
