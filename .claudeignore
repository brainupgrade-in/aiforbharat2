# AI for Bharat - DiabetCare AI Healthcare Project
# Claude Ignore File
# Files and directories that Claude Code should not read or analyze

# ============================================
# Large ML/AI Files
# ============================================
# Trained models (too large for context)
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.pb
*.tflite
*.onnx
*.weights
models/
checkpoints/
saved_models/

# Model logs and artifacts
logs/
tensorboard/
mlruns/
mlartifacts/
wandb/
lightning_logs/
*.tfevents.*

# ============================================
# Datasets
# ============================================
# Raw and processed datasets (too large)
data/
datasets/
*.csv
*.tsv
*.parquet
*.tfrecord
*.npy
*.npz

# Medical imaging files (fundus, retina scans)
fundus_images/
retina_scans/
medical_images/
patient_data/
*.dicom
*.dcm
*.nii
*.nii.gz

# Large JSON files (patient records, clinical data)
data/*.json
datasets/*.json
*.jsonl

# Exception: Keep small example/documentation files for reference
!data/samples/**
!data/examples/**
!docs/**
!research/**
!screenshots/**

