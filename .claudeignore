# ============================================
# Python dependencies
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Node modules (large, not needed for context)
node_modules/
.npm
.pnp
.pnp.js

