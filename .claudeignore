!docs/*.md
!docs/*.html
!docs/css/*.css
!docs/js/*.js

# Project configuration
!package.json
!tsconfig.json
!vite.config.js
!vite.config.ts

# SVG diagrams (small, informative)
!*.svg
!diagrams/*.svg

# Screenshots README (but not the actual large PNG files)
!screenshots/README.md

# Research markdown (but not large PDFs)
!research/*.md

# JavaScript/TypeScript source files
!src/**/*.js
!src/**/*.jsx
!src/**/*.ts
!src/**/*.tsx

# Amplify schema files (important for understanding data model)
!amplify/data/resource.ts
!amplify/auth/resource.ts
!amplify/storage/resource.ts

# Configuration files
!.gitignore
!.claudeignore
!.eslintrc.*
!.prettierrc
