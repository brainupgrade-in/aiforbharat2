# ============================================
# DiabetCare AI - Project Specific
# ============================================
# EXCEPTION: Allow docs/ folder for GitHub Pages hosting
!docs/
!docs/**/*
!docs/css/**/*
!docs/js/**/*
!docs/images/**/*
!docs/*.html
!docs/*.md
!docs/README.md

# EXCEPTION: Allow screenshots folder for app demos
!screenshots/
!screenshots/**/*
!screenshots/*.png
!screenshots/*.jpg
!screenshots/*.md

# EXCEPTION: Allow SVG diagrams and slides
!*.svg
!diagrams/*.svg
!slides/*.svg

# EXCEPTION: Allow research PDFs
!research/
!research/**/*
!research/*.pdf
!research/*.md

# EXCEPTION: Allow markdown documentation
!*.md
!docs/*.md
!README.md
!CLAUDE.md
!TECH_STACK.md
!IDEA_SUBMISSION.md
!DIABETES_FOCUS.md
!FUNDING_VALIDATION.md
!PROTOTYPE_COST_BREAKDOWN.md
!MVP_BUDGET_FINAL.md

# EXCEPTION: Allow presentation
!*.pptx
!"Idea Submission _ AWS AI for Bharat Hackathon.pptx"

# EXCEPTION: Allow Puppeteer screenshot script
!capture-fullpage-screenshots.js

# EXCEPTION: Allow package.json
!package.json

